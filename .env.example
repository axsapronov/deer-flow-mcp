# DeerFlow MCP server configuration (all values come from the environment)

# Required. Base URL of the deployed DeerFlow instance (the nginx entry point).
# Trailing slashes are ignored. Example: https://deerflow.example.com
DEERFLOW_BASE_URL=https://deerflow.example.com

# --- Authentication (configure at least one of the three modes below) ---

# Simplest / full-access: the same email + password you use in the DeerFlow web UI.
# The server logs in like the browser (POST /api/v1/auth/login/local) and carries the
# resulting session cookie on every call. Works on every deployment (no DB, no
# internal secret) and grants full user access (models + artifact files).
# Tried FIRST when set. DEERFLOW_EMAIL and DEERFLOW_PASSWORD must be set together.
DEERFLOW_EMAIL=
DEERFLOW_PASSWORD=

# Per-user: Personal Access Token. Create it in the DeerFlow UI or via
#   POST /api/v1/auth/pats  (session-authenticated)
# The token starts with "dfp_". Requires a DB backend (SQLite/Postgres) on the
# DeerFlow side; memory-only deployments reject Bearer tokens.
# NOTE: PAT callers can only reach the threads/runs routes. /api/models and
# individual artifact files are NOT reachable with a PAT (they 403). Use the
# internal-token mode below for full access.
DEERFLOW_PAT=

# Fallback / full-access: Gateway internal token. Set DEER_FLOW_INTERNAL_AUTH_TOKEN
# on the DeerFlow Gateway to a shared secret, then put that same value here.
# This bypasses the PAT route allowlist, so models + artifact files work.
DEERFLOW_INTERNAL_TOKEN=

# Only used with the internal-token mode. Acts on behalf of this user id
# (normally the owner of the DeerFlow account). Leave unset to use the default user.
DEERFLOW_OWNER_USER_ID=

# --- Optional defaults ---

# Default model name to use when a tool call omits `model` (see deerflow_list_models).
DEERFLOW_DEFAULT_MODEL=

# Default LangGraph recursion limit for runs (default: 1000, matching the web UI).
DEERFLOW_DEFAULT_RECURSION_LIMIT=1000

# Per-request HTTP timeout in milliseconds (default: 60000).
DEERFLOW_TIMEOUT_MS=60000

# Optional: base URL used to build human-friendly "open in DeerFlow" links.
# Defaults to DEERFLOW_BASE_URL. The link points at /workspace/chats/<thread_id>.
DEERFLOW_WEB_BASE_URL=
